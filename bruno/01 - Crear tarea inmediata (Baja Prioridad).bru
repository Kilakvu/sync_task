meta {
  name: Crear Tarea Inmediata (Baja Prioridad)
  type: http
  seq: 1
}

post {
  url: http://localhost:8081/api/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Limpiar Logs",
    "description": "Eliminar archivos de log antiguos",
    "payload": "{\"directory\": \"/var/logs\", \"daysOld\": 30}",
    "priority": "LOW",
    "maxRetries": 2
  }
}
